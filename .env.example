APP_NAME="E-Turismo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/e-turismo/public

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────────────────────
# IMPORTANT: DB_DATABASE must match the schema name EXACTLY as shown in phpMyAdmin.
# Common local-dev mistake: phpMyAdmin shows "eturismo_db" but .env has "laravel".
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eturismo_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── Queue ─────────────────────────────────────────────────────────────────────
# 'sync' is the safe default for XAMPP — jobs run immediately in the same request.
# To use async processing (recommended for production), change to 'database' or
# 'redis' and run a worker: php artisan queue:work
# NOTE: The user account is always created BEFORE the OCR job runs, regardless of
# the queue driver. A missing/crashed worker will NOT prevent accounts from being created.
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── OCR.space API ─────────────────────────────────────────────────────────────
# Required for ID photo verification during registration.
# Get a FREE key at: https://ocr.space/ocrapi/freekey (500 requests/day, 1 MB limit)
# For production (large camera photos up to 25 MB), upgrade to a paid plan.
# WARNING: Leaving this empty will throw a RuntimeException at registration time.
OCR_SPACE_API_KEY=
